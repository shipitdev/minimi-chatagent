# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-key-here

# ---------------------------------------------------------------------------
# Model / server
# ---------------------------------------------------------------------------
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

PORT=8787
MINIMI_DB=./data/minimi.db
MINIMI_DEFAULT_TZ=auto

# Compact search digest budget handed to the model (Coca-Cola port).
MINIMI_DIGEST_TOKENS=900

# Maximum shortlist items re-checked in parallel.
MINIMI_PARALLELISM=6

# 1 = log every model/search call with its token accounting.
MINIMI_DEBUG=0

# 1 = scripted backend (no network, no key). For demos, CI and eval mechanics.
MINIMI_OFFLINE=0

# ---------------------------------------------------------------------------
# Observability (LangSmith)
# ---------------------------------------------------------------------------
# Without a key every trace call is a no-op; the app runs normally.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=default
LANGSMITH_TRACING=true
