# ---------------------------------------------------------------------------
# Required: one DeepSeek platform key powers chat, Search and Fetch.
# https://platform.deepseek.com/api_keys
# ---------------------------------------------------------------------------
DEEPSEEK_API_KEY=sk-your-key-here

# DSH's model adapter. The launcher leaves DEEPSEEK_BASE_URL unset so the
# adapter uses https://api.deepseek.com/anthropic. Do not put base URLs in this
# file: DSH rejects launch-environment variables in .env. Export them instead.
DEEPSEEK_MODEL=deepseek-flash

# ---------------------------------------------------------------------------
# Minimi server / UI
# ---------------------------------------------------------------------------
PORT=8787
MINIMI_NO_OPEN=0

# ---------------------------------------------------------------------------
# Minimi search, evidence, and dated memory
# ---------------------------------------------------------------------------
# DeepSeek Search + Fetch REST root (internal to the one web_search tool).
MINIMI_SEARCH_BASE_URL=https://api.deepseek.com
MINIMI_DB=./data/minimi.db
MINIMI_DEFAULT_TZ=auto
MINIMI_DIGEST_TOKENS=900
MINIMI_SEARCH_CONCURRENCY=3
MINIMI_MAX_QUERIES_PER_CALL=3
MINIMI_MAX_CALLS_PER_TURN=2
MINIMI_MAX_PROVIDER_ATTEMPTS_PER_TURN=12
MINIMI_MAX_RESULTS_PER_QUERY=8

# 1 = write data/last-memory-context.txt, data/runtime-tools.json, and debug logs.
MINIMI_DEBUG=0

# Deterministic search fixtures for tests (a directory with search.json/fetch.json;
# tests create one in a temp directory).
# MINIMI_SEARCH_FIXTURES=/absolute/path/to/fixtures

# Optional shared key for the public demo gateway (npm run demo).
# Leave empty to allow anyone with the public URL to enter. Prefer a GitHub
# Actions secret or data/private/access-key (mode 600); do not commit a key.
# MINIMI_ACCESS_KEY=


# LangSmith (optional; never commit a real key). The golden adapter falls back
# to local trace trees when this key is missing or forbidden.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=minimi-golden-v2
LANGSMITH_TRACING=true

# DeepEval uses the same DeepSeek key; optional judge model override.
# DEEPEVAL_MODEL=deepseek-flash
