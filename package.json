{
  "name": "minimi",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Gen-UI chat agent on DeepSeek V4.1 Flash with exactly one tool (web_search), durable timezone-aware memory, and parallel shortlist re-checking.",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch --clear-screen=false src/server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "eval": "tsx evals/run.ts",
    "eval:offline": "MINIMI_OFFLINE=1 tsx evals/run.ts",
    "bench:digest": "tsx evals/digest-bench.ts",
    "demo": "MINIMI_OFFLINE=1 npm run dev",
    "test:ui": "tsx tests/render.tsx",
    "smoke": "tsx tests/smoke.ts",
    "eval:golden": "python3 evals/golden/run.py run --adapter 'node --import tsx evals/adapter.ts'",
    "eval:citations": "bash -c 'for s in dev holdout live; do .venv-eval/bin/python evals/deepeval_citations.py runs/golden/$s.json; done'",
    "trace:audit": "tsx evals/trace_audit.ts",
    "ls:experiment": "tsx evals/langsmith_experiment.ts"
  },
  "dependencies": {
    "@openuidev/react-lang": "^1.1.0",
    "@openuidev/react-ui": "^0.18.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "langsmith": "^0.12.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
